# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Secrets / local environment (GridSight's .env holds API keys and AWS credentials)
.env
.env.*
!.env.example
*.pem
*.key

# DuckDB databases (each benchmark run creates its own; regenerated by the CLI)
*.duckdb
*.duckdb.wal

# Heavy per-run artifacts. Summaries (results/summary/statistics CSVs, config/metadata JSON)
# and plots under outputs*/ are intentionally tracked.
outputs*/**/bronze_sim/
outputs*/**/checkpoints/
outputs*/**/logs/
outputs*/*.log
outputs*/*.pid

# dbt build artifacts and local dbt telemetry id
validation/dbt/target/
validation/dbt/dbt_packages/
validation/dbt/logs/
validation/dbt/.user.yml

# Logs / temp
*.log
*.pid
*.tmp
*.bak

# OS / editor
.DS_Store
.vscode/
.idea/

# AI-assistant local files (never publish)
.claude/
CLAUDE.md
